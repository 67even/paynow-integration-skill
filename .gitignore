# Language / tooling noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

vendor/
composer.lock
.phpunit.result.cache

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini


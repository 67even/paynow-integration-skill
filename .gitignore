# ---------------------------------------------------------------------------
# Working artefacts — not part of the published skill
# ---------------------------------------------------------------------------
Claude outputs/
Reviews/

# Eval workspace: generated run outputs, gradings, benchmarks and review pages
paynow-integration-workspace/
*-workspace/
paynow-skill-review.html
feedback.json

# Packaged skill bundle — rebuild it with scripts/package_skill.py, don't commit binaries
*.skill

# ---------------------------------------------------------------------------
# Secrets — the Paynow integration key must never reach version control
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!env.example
*.key
*.pem
secrets.json


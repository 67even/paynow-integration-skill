# Paynow — never commit real values.
# The Integration Key is never shown in the dashboard: use
# "Email Key To Company Address" to receive it.

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Test mode: only the merchant account that owns the integration can complete a
# payment, so authemail must be a merchant login address. Set this to one, or you
# will lock yourself out of your own test transactions.
PAYNOW_TEST_MODE=true
PAYNOW_MERCHANT_EMAIL=
